{
  "name": "@baseline/web-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web-e2e/src",
  "implicitDependencies": ["@baseline/web"],
  "// targets": "to see all targets run: nx show project @baseline/web-e2e --web",
  "targets": {
    "e2e": {
      "cache": false,
      "dependsOn": ["typecheck", "^build"],
      "options": {
        "command": "playwright test --project=chromium"
      },
      "configurations": {
        "all": {
          "command": "playwright test"
        }
      }
    },
    "lint": {
      "dependsOn": ["lint-eslint", { "projects": ["@baseline/source"], "target": "lint" }]
    }
  }
}
