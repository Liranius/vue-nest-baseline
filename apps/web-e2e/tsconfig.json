{
  "extends": ["../../tsconfig.base.json", "@tsconfig/node24/tsconfig.json"],
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "rootDir": ".",
    "outDir": "out-tsc/playwright",
    "tsBuildInfoFile": "out-tsc/playwright/tsconfig.tsbuildinfo",
    "sourceMap": false
  },
  "include": ["**/*"],
  "exclude": ["out-tsc", "test-output"]
}
