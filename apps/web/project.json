{
  "name": "@baseline/web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web/src",
  "// targets": "to see all targets run: nx show project @baseline/web --web",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals", "webEnvironment"],
    "webEnvironment": [
      { "fileset": "{projectRoot}/env/.env*", "includeIgnored": true },
      { "env": "VITE_APP_TITLE" },
      { "env": "NODE_ENV" }
    ]
  },
  "targets": {
    "build": {
      "executor": "nx:noop",
      "dependsOn": ["build-only", "typecheck"]
    },
    "build-only": {
      "dependsOn": ["^build"],
      "inputs": [
        "...",
        "{workspaceRoot}/tsconfig*.json",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/pnpm-workspace.yaml",
        "{workspaceRoot}/postcss.config.*",
        "{workspaceRoot}/.postcssrc*"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", { "projects": ["@baseline/source"], "target": "typecheck" }],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/pnpm-lock.yaml"
      ],
      "outputs": ["{projectRoot}/out-tsc"]
    },
    "test-watch": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "dependsOn": ["^build"],
      "options": {
        "cwd": "apps/web",
        "command": "vitest --watch"
      }
    },
    "preview": {
      "dependsOn": ["build"]
    },
    "serve-static": {
      "dependsOn": ["build"]
    },
    "lint": {
      "dependsOn": [
        "lint-eslint",
        "lint-style",
        { "projects": ["@baseline/source"], "target": "lint" }
      ]
    },
    "lint-fix": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [{ "projects": ["@baseline/source"], "target": "lint-fix" }],
      "options": {
        "cwd": "apps/web",
        "commands": [
          "oxlint . --fix",
          "eslint . --fix",
          "stylelint \"src/**/*.{css,vue}\" --config ../../stylelint.config.mjs --fix"
        ],
        "parallel": false,
        "forwardAllArgs": false
      }
    },
    "lint-style": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.{css,vue}", "lintGlobals"],
      "options": {
        "cwd": "apps/web",
        "command": "stylelint \"src/**/*.{css,vue}\" --config ../../stylelint.config.mjs"
      }
    }
  }
}
