{
  "extends": ["../../tsconfig.base.json", "@vue/tsconfig/tsconfig.dom.json"],
  "compilerOptions": {
    "noEmit": false,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "outDir": "out-tsc/app",
    "types": ["vite/client"],
    "rootDir": "src",
    "tsBuildInfoFile": "out-tsc/app/tsconfig.app.tsbuildinfo"
  },
  "exclude": ["src/**/*.spec.*", "src/**/*.test.*", "src/**/__tests__/**"],
  "include": ["src/**/*", "src/**/*.vue"]
}
