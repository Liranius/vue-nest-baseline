  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "nx": {
    "targets": {
      "lint": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "lintGlobals",
          "{workspaceRoot}/*.config.{js,mjs,cjs,ts,mts,cts}",
          "{workspaceRoot}/tsconfig.json"
        ],
        "options": {
          "commands": [
            "oxlint eslint.config.mjs stylelint.config.mjs vitest.config.mts",
            "eslint eslint.config.mjs stylelint.config.mjs vitest.config.mts"
          ],
          "parallel": false
        }
      }
    }
  }
