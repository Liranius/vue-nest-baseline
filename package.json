{
  "name": "@baseline/source",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {},
  "dependencies": {
    "@vue/devtools-api": "8.2.1",
    "pinia": "4.0.3",
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@nestjs/schematics": "^11.0.0",
    "@nx/devkit": "24.0.3",
    "@nx/eslint": "24.0.3",
    "@nx/js": "24.0.3",
    "@nx/nest": "24.0.3",
    "@nx/oxlint": "24.0.3",
    "@nx/playwright": "24.0.3",
    "@nx/vite": "24.0.3",
    "@nx/vitest": "24.0.3",
    "@nx/vue": "24.0.3",
    "@nx/web": "24.0.3",
    "@playwright/test": "1.64.1",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@tsconfig/node24": "24.0.5",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/eslint-plugin": "1.6.27",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-oxlint": "1.90.0",
    "eslint-plugin-playwright": "2.12.0",
    "eslint-plugin-vue": "10.11.0",
    "globals": "17.12.0",
    "jiti": "2.7.0",
    "js-yaml": "4.3.2",
    "jsdom": "30.1.0",
    "lefthook": "2.1.14",
    "nx": "24.0.3",
    "oxfmt": "0.67.0",
    "oxlint": "1.90.0",
    "postcss-html": "2.0.0",
    "stylelint": "17.15.0",
    "stylelint-config-recommended-vue": "2.0.0",
    "stylelint-config-standard": "40.0.0",
    "tslib": "2.9.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vite-plugin-vue-devtools": "8.2.1",
    "vitest": "5.0.5",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "2.2.12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.22.2 <25",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24.22.2 <25",
    "pnpm": "12.4.2"
  },
  "packageManager": "pnpm@12.4.2",
  "nx": {
    "targets": {
      "typecheck": {
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [],
        "inputs": [
          "{workspaceRoot}/*.config.{ts,mts,cts}",
          "{workspaceRoot}/config/**/*.{ts,mts,cts}",
          "{workspaceRoot}/tests/**/*.ts",
          "{workspaceRoot}/tsconfig.base.json",
          "{workspaceRoot}/tsconfig.node.json",
          "{workspaceRoot}/package.json",
          "{workspaceRoot}/pnpm-lock.yaml"
        ],
        "outputs": [
          "{workspaceRoot}/out-tsc/node"
        ],
        "options": {
          "command": "tsc --build tsconfig.node.json --emitDeclarationOnly"
        }
      },
      "hooks-install": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "lefthook install"
        }
      },
      "knowledge-setup": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node scripts/knowledge.mjs setup"
        }
      },
      "knowledge-doctor": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node scripts/knowledge.mjs doctor"
        }
      },
      "knowledge-cli": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node scripts/knowledge.mjs cli"
        }
      },
      "knowledge-check": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node scripts/knowledge-review.mjs check"
        }
      },
      "knowledge-find": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node scripts/knowledge-review.mjs find"
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [],
        "inputs": [
          "{workspaceRoot}/scripts/**",
          "{workspaceRoot}/tests/**",
          "{workspaceRoot}/apps/web-e2e/playwright.config.mts",
          "{workspaceRoot}/.codex/**",
          "{workspaceRoot}/vitest.config.mts",
          "{workspaceRoot}/tsconfig*.json",
          "{workspaceRoot}/package.json",
          "{workspaceRoot}/pnpm-lock.yaml"
        ],
        "options": {
          "command": "vitest run --project source"
        }
      },
      "commitlint": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "commitlint --verbose"
        }
      },
      "lint-staged-oxlint": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "oxlint --fix --no-error-on-unmatched-pattern"
        }
      },
      "lint-staged-eslint": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "eslint --fix"
        }
      },
      "lint-staged-style": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "stylelint --fix"
        }
      },
      "format": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "oxfmt"
        }
      },
      "format-check": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{workspaceRoot}/**/*",
          {
            "externalDependencies": [
              "oxfmt"
            ]
          }
        ],
        "options": {
          "command": "oxfmt --check"
        }
      },
      "lint-fix": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "commands": [
            "oxlint eslint.config.mjs stylelint.config.mjs commitlint.config.mjs vitest.config.mts scripts tests --fix",
            "eslint eslint.config.mjs stylelint.config.mjs commitlint.config.mjs vitest.config.mts scripts tests --fix"
          ],
          "parallel": false,
          "forwardAllArgs": false
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "lintGlobals",
          "{workspaceRoot}/*.config.{js,mjs,cjs,ts,mts,cts}",
          "{workspaceRoot}/scripts/**",
          "{workspaceRoot}/tests/**",
          "{workspaceRoot}/tsconfig.json"
        ],
        "options": {
          "commands": [
            "oxlint eslint.config.mjs stylelint.config.mjs commitlint.config.mjs vitest.config.mts scripts tests",
            "eslint eslint.config.mjs stylelint.config.mjs commitlint.config.mjs vitest.config.mts scripts tests"
          ],
          "parallel": false
        }
      }
    }
  }
}
