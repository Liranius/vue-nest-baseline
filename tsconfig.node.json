{
  "extends": ["./tsconfig.base.json", "@tsconfig/node24/tsconfig.json"],
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "rootDir": ".",
    "outDir": "out-tsc/node",
    "tsBuildInfoFile": "out-tsc/node/tsconfig.node.tsbuildinfo"
  },
  "include": ["*.ts", "*.mts", "*.cts", "config", "scripts", "tests"]
}
